+
+#ifdef FUXI_PANIC_FASTBOOT
+/* The reset layer owns every register and every firmware call; this file only decides when to ask,
+ * and waits out the drain window first because the console has to stay up until the request is
+ * formatted. */
+extern int qcom_reset_prepare_bootloader(void);
+extern int qcom_reset_to_bootloader(void);
+static void fuxi_prepare_fastboot(void)
+{
+    int seconds = 0;
+    if (!PE_parse_boot_argn("fuxi-panic-fastboot", &seconds, sizeof(seconds)) || seconds != 30)
+        return;
+    (void)qcom_reset_prepare_bootloader();
+}
+static void fuxi_panic_fastboot(void)
+{
+    uint64_t hz = native.status.counter_frequency;
+    if (!hz || hz > COUNTER_MAX_FREQUENCY) return;
+    uint64_t start = counter();
+    while (counter() - start < 30 * hz) __asm__ volatile("yield" ::: "memory");
+    (void)qcom_reset_to_bootloader();
 }
+#endif
