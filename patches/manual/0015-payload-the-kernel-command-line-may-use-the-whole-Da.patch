From 3eece89510828ea8da520b7fb1951cf07765a2e1 Mon Sep 17 00:00:00 2001
From: ljhhkx529 <ljhzyx520@gmail.com>
Date: Tue, 17 Nov 2026 18:29:40 +0800
Subject: [PATCH 15/15] payload: the kernel command line may use the whole
 DarwinBoot buffer

DarwinBoot copies the command line into a 1024-byte buffer and refuses an index
at or above sizeof (CommandLine) - 1, so 1023 bytes fit with their terminator.
XNU reads the same buffer (BOOT_LINE_LENGTH 1024 in pexpert/pexpert/arm64/boot.h).

The board's own command line is 1022 bytes, so the previous 1000-byte limit
refused to package it. The limit is now the buffer's real size, in both the
payload builder and the pipeline that measures the line before the build.
---
 scripts/unixnu/payload.py  | 11 +++++++----
 scripts/unixnu/pipeline.py |  5 ++++-
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/scripts/unixnu/payload.py b/scripts/unixnu/payload.py
index 9658e13..672a21a 100644
--- a/scripts/unixnu/payload.py
+++ b/scripts/unixnu/payload.py
@@ -32,9 +32,12 @@ def check_args(arguments):
         if not re.fullmatch(r'[A-Za-z0-9_.\-]+(=[A-Za-z0-9_.,/\-]+)?', value):
             raise Error(f'unsupported kernel argument: {value}')
     line = ' '.join(arguments)
-    # DarwinBoot copies the command line into a 1024-byte buffer and refuses a longer one.
-    if len(line) > 1000:
-        raise Error(f'the kernel command line is {len(line)} bytes; the limit is 1000')
+    # DarwinBoot copies the command line into a 1024-byte buffer and refuses a longer one:
+    # DarwinBootPkg/Driver/DarwinBoot.c rejects at "Index >= sizeof (CommandLine) - 1", so 1023 bytes
+    # fit with their terminator, and XNU reads the same buffer (BOOT_LINE_LENGTH 1024 in
+    # pexpert/pexpert/arm64/boot.h).
+    if len(line) > 1023:
+        raise Error(f'the kernel command line is {len(line)} bytes; the limit is 1023')
     return line
 
 
@@ -247,7 +250,7 @@ def build(ctx, kernel=None):
             command.append('--ipad-identity')
         if data and adt.get('persistent_data'):
             command.append('--persistent-data')
-        # Fixups of signed text (patches/xnu/native-text-fixup.patch) travel in /chosen/text-fixups, outside the 1000-byte command line.
+        # Fixups of signed text (patches/xnu/native-text-fixup.patch) travel in /chosen/text-fixups, outside the command line.
         for fixup in spec.get('text_fixups', []):
             if not re.fullmatch(r'[A-Za-z0-9_.\-]{1,63},[0-9a-fA-F]{1,16},(?:[0-9a-fA-F]{2}){1,16},(?:[0-9a-fA-F]{2}){1,16}', fixup) or len(fixup) >= 160:
                 raise Error(f'malformed text fixup in board.toml [payload] text_fixups: {fixup}')
diff --git a/scripts/unixnu/pipeline.py b/scripts/unixnu/pipeline.py
index fbeac31..f652877 100644
--- a/scripts/unixnu/pipeline.py
+++ b/scripts/unixnu/pipeline.py
@@ -9,7 +9,10 @@ from pathlib import Path
 from . import payload
 from .util import Error, git, log, sha256_file
 
-MAX_COMMAND_LINE = 1000
+# DarwinBoot's CommandLine buffer is 1024 bytes and it refuses an index at or above
+# sizeof (CommandLine) - 1, so 1023 bytes fit with their terminator. XNU reads the same
+# buffer (BOOT_LINE_LENGTH 1024 in pexpert/pexpert/arm64/boot.h).
+MAX_COMMAND_LINE = 1024
 
 
 def outputs(ctx):
