From b6e6f8729fae4ec48094434bbe04adb527abe87f Mon Sep 17 00:00:00 2001
From: ljhhkx529 <ljhzyx520@gmail.com>
Date: Tue, 17 Nov 2026 18:27:42 +0800
Subject: [PATCH 10/15] components: AdrenoMetal and GopFramebuffer back to
 official

Both forks existed only to add diagnostics the bring-up used to read its way to
rendering; neither is a functional dependency, so both go back to the official
commits:

  AdrenoMetal     6d7f73437087c57ee54a41adceb1735daaea405e
  GopFramebuffer  e47c1b8de169cd2bd0b885c7d85e433010e3cdf2

Verified on the device before the rest of the cleanup: the Metal plugin still
returns the native device and the present path did not regress (fence 85/85,
GOP 37/37).
---
 components.toml        | 6 ++++--
 drivers/AdrenoMetal    | 2 +-
 drivers/GopFramebuffer | 2 +-
 3 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/components.toml b/components.toml
index 1607fd5..392d99b 100644
--- a/components.toml
+++ b/components.toml
@@ -83,6 +83,8 @@ kind = "driver"
 function = "A740 kernel GPU driver"
 scope = "gpu"
 repository = "https://github.com/UniXNU/Adreno740.git"
+# fuxi bring-up overlay rebased on upstream 6fa7bae2a5b3b523e790eb3e0348af4d98969e4d:
+# keep the two-dword CP_SMMU_TABLE_UPDATE, process-table read-back, kernel-table mount and thread-control fixes.
 revision = "a9a2cbb43b89d672e2921e19721a6438b738b17f"
 path = "drivers/Adreno740"
 hardware = ["Adreno 740", "SM8550"]
@@ -105,7 +107,7 @@ kind = "driver"
 function = "Metal frontend through metal2vulkan and Turnip"
 scope = "graphics"
 repository = "https://github.com/UniXNU/AdrenoMetal.git"
-revision = "a0f0287be80a5d8aef5c6b97a6cab62129e152bd"
+revision = "6d7f73437087c57ee54a41adceb1735daaea405e"
 path = "drivers/AdrenoMetal"
 hardware = ["Turnip Darwin backend", "kernel GPU user-client ABI"]
 os_abi = ["ipados-17.7.11-21H461"]
@@ -231,7 +233,7 @@ kind = "driver"
 function = "UEFI GOP framebuffer and MobileFramebuffer integration"
 scope = "display"
 repository = "https://github.com/UniXNU/GopFramebuffer.git"
-revision = "19ef3a75ad2c53da85b8d923553d922716fce377"
+revision = "e47c1b8de169cd2bd0b885c7d85e433010e3cdf2"
 path = "drivers/GopFramebuffer"
 hardware = ["UEFI GOP framebuffer"]
 os_abi = ["ipados-17.7.11-21H461", "ipados-27.0.1-24A446"]
diff --git a/drivers/AdrenoMetal b/drivers/AdrenoMetal
index a0f0287..6d7f734 160000
--- a/drivers/AdrenoMetal
+++ b/drivers/AdrenoMetal
@@ -1 +1 @@
-Subproject commit a0f0287be80a5d8aef5c6b97a6cab62129e152bd
+Subproject commit 6d7f73437087c57ee54a41adceb1735daaea405e
diff --git a/drivers/GopFramebuffer b/drivers/GopFramebuffer
index 19ef3a7..e47c1b8 160000
--- a/drivers/GopFramebuffer
+++ b/drivers/GopFramebuffer
@@ -1 +1 @@
-Subproject commit 19ef3a75ad2c53da85b8d923553d922716fce377
+Subproject commit e47c1b8de169cd2bd0b885c7d85e433010e3cdf2
