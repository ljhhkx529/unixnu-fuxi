                         '-c', rt / f'lib/profile/{name}.c', '-o', objects / f'{name}.o'], check=True)
     subprocess.run(['xcrun', 'libtool', '-static', '-o', out, *(objects / f'{n}.o' for n in PROFILE_SOURCES)],
                    check=True)
