@@ -68,6 +70,30 @@ PAINT = """
   dsb sy
 """
 
+# Yellow band for stage 5. This runs after the MMU is on, so it draws through
+# the kernel's vinfo (v_baseaddr is the mapped framebuffer), not the boot-args
+# physical address. Band index 3 = below DarwinBoot's green, blue and magenta.
+YELLOW_PAINT = """
+  ldr  x9, =stage
+  ldr  w11, [x9]
+  ldr  x9, =vinfo
+  ldr  w10, [x9, #12]
+  ldr  w13, [x9, #0]
+  ldr  x9, [x9, #16]
+  mul  x10, x10, x13
+  lsr  x10, x10, #4
+  bic  x10, x10, #7
+  mul  x12, x10, x11
+  add  x9, x9, x12
+  movz w13, #0xFF00
+  movk w13, #0xFFFF, lsl #16
+1:
+  stp  w13, w13, [x9], #8
+  subs x10, x10, #8
+  b.hi 1b
+  dsb  sy
+"""
+
 SOURCES = {
     1: ".text\n.global _start\n_start:\n" + PAINT.format(args='x0', band=1, lo='0x00FF', hi='0xFF00') + "  b target\n",
     2: ".text\n.global _start\n_start:\n" + PAINT.format(args='x20', band=2, lo='0x00FF', hi='0xFFFF')
@@ -116,6 +142,7 @@ _start:
   wfe
   b 2b
 """ + ".ltorg\n",
+    5: ".text\n.global _start\n_start:\n  .inst 0x52800088\n  .inst 0xb90ecf28\n" + YELLOW_PAINT + "  b target\n.ltorg\n",
 }
 
 RESET_BEFORE = """.text
@@ -170,6 +197,70 @@ def find_call(data, symbols, function, name, occurrence):
     return hits[occurrence - 1]
 
 
+def find_call_anywhere(data, symbols, name, occurrence=1):
+    """The VA and target of the Nth `bl name` anywhere in the kernel text."""
+    hits = []
+    for vmaddr, vmsize, fileoff, filesize in SEGMENTS:
+        if not filesize:
+            continue
+        limit = min(vmsize, filesize)
+        for va in range(vmaddr, vmaddr + limit, 4):
+            word = struct.unpack_from('<I', data, fileoff + (va - vmaddr))[0]
+            if word >> 26 == 0b100101:
+                delta = word & 0x3FFFFFF
+                delta -= (1 << 26) if delta & (1 << 25) else 0
+                target = va + delta * 4
+                if symbols.get(target) == name:
+                    hits.append((va, target))
+    if len(hits) < occurrence:
+        raise SystemExit(f'No bl {name} found ({len(hits)} hits)')
+    return hits[occurrence - 1]
+
+
+def find_dlxk_link_ret(data):
+    """Locate image4_dlxk_link's `ret` by its unique instruction sequence.
+
+    The symbol is stripped from the prelinked kernel, but the function body is
+    stable: adrp x8; ldr x9,[x8,#off]; cbnz x9,+8; str x0,[x8,#off]; ret.
+    """
+    ldr = bytes.fromhex('09e542f9')  # 0xf942e509 little-endian
+    for vmaddr, vmsize, fileoff, filesize in SEGMENTS:
+        if not filesize:
+            continue
+        region = data[fileoff:fileoff + min(vmsize, filesize)]
+        i = 0
+        while True:
+            i = region.find(ldr, i)
+            if i < 0:
+                break
+            w1 = struct.unpack_from('<I', region, i + 4)[0]
+            w2 = struct.unpack_from('<I', region, i + 8)[0]
+            w3 = struct.unpack_from('<I', region, i + 12)[0]
+            if w1 == 0xB5000069 and w2 == 0xF902E500 and w3 == 0xD65F03C0:
+                return vmaddr + i + 12  # address of the `ret`
+            i += 4
+    raise SystemExit('image4_dlxk_link sequence not found')
+
+
+def find_stage4_write(data):
+    """Locate the Data-mount stage=4 write (mov w8,#4; str w8,[x25,#0xecc])."""
+    mov = struct.pack('<I', 0x52800088)
+    st = struct.pack('<I', 0xB90ECF28)
+    for vmaddr, vmsize, fileoff, filesize in SEGMENTS:
+        if not filesize:
+            continue
+        region = data[fileoff:fileoff + min(vmsize, filesize)]
+        i = 0
+        while True:
+            i = region.find(mov, i)
+            if i < 0:
+                break
+            if region[i + 4:i + 8] == st:
+                return vmaddr + i
+            i += 4
+    raise SystemExit('Data mount stage=4 write not found')
+
+
 def assemble_c(source, va, workdir, symbols):
     """Build a freestanding C file for VA; returns (bytes, load address of the first byte, address of panic_screen).
 
@@ -361,6 +452,8 @@ def main():
