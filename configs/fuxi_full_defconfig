# fuxi full bring-up, Pong-style native storage chain.
#
# Build only the native UFS root windows and the RAM-backed Data seed. The
# audited UFS/owner-root/Virtio path stays off because fuxi has no Virtio
# block transport and no repository-carried live storage capture. Sheng
# GPU/PMGR/Adreno bring-up is intentionally not enabled here.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_BUILD_WERROR=n
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

# Storage chain: UFS SHNGROOT windows for OS/SystemOS, RAM block for Data.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n

# Owner SystemOS/Data mount path.
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="3E81D4A6-8D16-496B-B890-E680C6E6997C"
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_CRYPTEX_FILES=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/legacy-stub/libLegacyStub.a {tree}/build/boot-log/libBootLog.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
